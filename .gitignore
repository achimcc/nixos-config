result
.env
# flake.lock sollte NICHT ignoriert werden - es sichert reproduzierbare Builds!

# Klartext-Secrets (verschlüsselte .yaml dürfen committed werden)
secrets/*.template
secrets/*.plaintext

# Von Claude Code erzeugte Typen je Mod (schreibt die Engine beim Laden)
mods/*/.claude-plugin/types/

# Python-Bytecode (entsteht beim lokalen Ausführen von Skripten wie vr-monitore.py)
__pycache__/
